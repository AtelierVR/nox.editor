/* Shared panel styles for nox.editor panels */

.hidden {
    display: none;
}

/* Status dots */
.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin: 2px;
}

.status-loaded-dot.is-loaded   { background-color: rgb(0, 200, 80);   }
.status-loaded-dot.is-unloaded { background-color: rgb(100, 100, 100); }

.status-main-dot   { background-color: rgb(255, 103,   0); }
.status-client-dot { background-color: rgb(255,   0, 243); }
.status-server-dot { background-color: rgb(  0, 200,  80); }
.status-editor-dot { background-color: rgb(  0, 240, 255); }
.status-custom-dot { background-color: rgb(255, 226,   0); }

/* Entry-point section labels */
.section-label-main   { font-size: 11px; color: rgb(255, 103,   0); }
.section-label-client { font-size: 11px; color: rgb(255,   0, 243); }
.section-label-server { font-size: 11px; color: rgb(  0, 200,  80); }
.section-label-editor { font-size: 11px; color: rgb(  0, 240, 255); }
.section-label-custom { font-size: 11px; color: rgb(255, 226,   0); }

/* Graph containers */
.graph-container {
    height: 200px;
    background-color: rgb(42, 42, 42);
    border-radius: 4px;
    overflow: hidden;
}

.graph-container-sm {
    height: 120px;
    background-color: rgb(42, 42, 42);
    border-radius: 4px;
    margin-bottom: 8px;
    overflow: hidden;
}

/* Profiler line row */
.profiler-row {
    flex-direction: row;
    align-items: center;
    padding: 4px;
    margin: 2px 0;
    background-color: rgb(50, 50, 50);
    border-radius: 2px;
}

.color-indicator {
    width: 8px;
    height: 16px;
    border-radius: 2px;
    margin-right: 8px;
}

.profiler-name-label {
    flex-grow: 1;
    min-width: 120px;
}

.profiler-ms-label {
    min-width: 60px;
    -unity-text-align: middle-right;
}

.profiler-ms-secondary {
    min-width: 60px;
    -unity-text-align: middle-right;
}

/* Predefined profiler colors (index 0-11) */
.profiler-color-0  { background-color: rgb(255,  80,  80); }
.profiler-color-1  { background-color: rgb(255, 160,  40); }
.profiler-color-2  { background-color: rgb(255, 220,  40); }
.profiler-color-3  { background-color: rgb(100, 220,  60); }
.profiler-color-4  { background-color: rgb( 40, 200, 100); }
.profiler-color-5  { background-color: rgb( 40, 220, 180); }
.profiler-color-6  { background-color: rgb( 40, 180, 255); }
.profiler-color-7  { background-color: rgb( 80, 100, 255); }
.profiler-color-8  { background-color: rgb(160,  80, 255); }
.profiler-color-9  { background-color: rgb(220,  40, 180); }
.profiler-color-10 { background-color: rgb(255,  40, 120); }
.profiler-color-11 { background-color: rgb(200, 200, 200); }

/* Toolbar search field constraint */
.toolbar-input {
    flex-grow: 0;
    min-width: 80px;
    max-width: 160px;
}

/* Inline badges */
.badge {
    font-size: 10px;
    margin-left: 4px;
    padding: 1px 4px;
    border-radius: 2px;
}

.badge-warning {
    background-color: var(--color-warning);
    color: rgb(0, 0, 0);
}

.badge-success {
    background-color: var(--color-success);
    color: rgb(255, 255, 255);
}

/* Bold text */
.text-bold {
    -unity-font-style: bold;
}

/* Key label (fixed min-width for key-value rows) */
.key-label {
    min-width: 96px;
}

/* Layout */
.flex-fill {
    flex-grow: 1;
    min-height: 0;
}
