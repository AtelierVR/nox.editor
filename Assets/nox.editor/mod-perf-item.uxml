<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <engine:VisualElement class="unity-text-field__input" style="flex-grow: 0; padding: 8px; margin: 4px 2px; background-color: rgb(39, 39, 39); border-radius: 4px;">
        <engine:Foldout name="mod-foldout" text="Mod Name" value="false" style="margin: 0;">
            <engine:VisualElement name="mod-content" style="margin: 8px 0;">
                <engine:VisualElement name="metrics-summary" style="flex-direction: row; margin-bottom: 8px;">
                    <engine:Label name="total-time" text="Total: 0.00ms" style="flex-grow: 1; font-size: 12px;" />
                    <engine:Label name="avg-time" text="Avg: 0.00ms" style="flex-grow: 1; font-size: 12px;" />
                    <engine:Label name="peak-time" text="Peak: 0.00ms" style="flex-grow: 1; font-size: 12px;" />
                </engine:VisualElement>
                
                <engine:VisualElement name="performance-graph" style="height: 120px; background-color: rgb(42, 42, 42); border-radius: 4px; margin-bottom: 8px;" />
                
                <engine:VisualElement name="profilers-list" style="margin-top: 8px;" />
            </engine:VisualElement>
        </engine:Foldout>
    </engine:VisualElement>
</engine:UXML>

