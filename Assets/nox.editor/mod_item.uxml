<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <engine:VisualElement class="unity-text-field__input" style="flex-grow: 0; padding: 8px; margin: 4px 2px; background-color: rgb(39, 39, 39); border-radius: 4px;">
        <engine:VisualElement name="header" style="flex-direction: row; align-items: center; margin-bottom: 4px;">
            <engine:Label name="mod-id" text="mod.id" style="flex-grow: 1; font-size: 14px; -unity-font-style: bold;" />
            <engine:Label name="mod-version" text="v1.0.0" style="color: rgb(180, 180, 180); margin-left: 8px;" />
            <engine:VisualElement name="status-indicators" style="flex-direction: row; margin-left: 8px;">
                <engine:VisualElement name="status-loaded" tooltip="Mod is loaded" style="width: 8px; height: 8px; background-color: rgb(0, 255, 0); border-radius: 50%; margin: 2px;" />
                <engine:VisualElement name="status-main" tooltip="Has main entry points" style="width: 8px; height: 8px; background-color: rgb(255, 103, 0); border-radius: 50%; margin: 2px;" />
                <engine:VisualElement name="status-client" tooltip="Has client entry points" style="width: 8px; height: 8px; background-color: rgb(255, 0, 243); border-radius: 50%; margin: 2px;" />
                <engine:VisualElement name="status-server" tooltip="Has server entry points" style="width: 8px; height: 8px; background-color: rgb(0, 255, 0); border-radius: 50%; margin: 2px;" />
                <engine:VisualElement name="status-editor" tooltip="Has editor entry points" style="width: 8px; height: 8px; background-color: rgb(0, 240, 255); border-radius: 50%; margin: 2px;" />
                <engine:VisualElement name="status-custom" tooltip="Has custom entry points" style="width: 8px; height: 8px; background-color: rgb(255, 226, 0); border-radius: 50%; margin: 2px;" />
            </engine:VisualElement>
            <engine:Button text="Select" name="select-button" style="margin-left: 8px;" />
        </engine:VisualElement>
        
        <engine:VisualElement name="mod-info" style="margin-bottom: 4px;">
            <engine:Label name="mod-name" text="Mod Name" style="color: rgb(200, 200, 200);" />
            <engine:Label name="mod-license" text="License" style="color: rgb(150, 150, 150); font-size: 11px;" />
        </engine:VisualElement>
        
        <engine:Foldout text="Details" value="false" name="details-foldout">
            <engine:VisualElement style="margin: 4px 0;">
                <engine:Label name="provides-label" text="Provides:" style="font-size: 12px; -unity-font-style: bold; margin-bottom: 2px;" />
                <engine:VisualElement name="provides-list" style="margin-left: 16px;" />
                
                <engine:Label text="Entry Points:" style="font-size: 12px; -unity-font-style: bold; margin: 8px 0 2px 0;" />
                <engine:VisualElement name="entry-points" style="margin-left: 16px;">
                    <engine:VisualElement name="main-entries" style="margin-bottom: 4px;">
                        <engine:Label name="main-header" text="Main:" style="font-size: 11px; color: rgb(255, 103, 0);" />
                        <engine:VisualElement name="main-list" style="margin-left: 12px;" />
                    </engine:VisualElement>
                    
                    <engine:VisualElement name="client-entries" style="margin-bottom: 4px;">
                        <engine:Label name="client-header" text="Client:" style="font-size: 11px; color: rgb(255, 0, 243);" />
                        <engine:VisualElement name="client-list" style="margin-left: 12px;" />
                    </engine:VisualElement>
                    
                    <engine:VisualElement name="server-entries" style="margin-bottom: 4px;">
                        <engine:Label name="server-header" text="Server:" style="font-size: 11px; color: rgb(0, 255, 0);" />
                        <engine:VisualElement name="server-list" style="margin-left: 12px;" />
                    </engine:VisualElement>
                    
                    <engine:VisualElement name="editor-entries" style="margin-bottom: 4px;">
                        <engine:Label name="editor-header" text="Editor:" style="font-size: 11px; color: rgb(0, 240, 255);" />
                        <engine:VisualElement name="editor-list" style="margin-left: 12px;" />
                    </engine:VisualElement>
                    
                    <engine:VisualElement name="custom-entries" style="margin-bottom: 4px;">
                        <engine:Label name="custom-header" text="Custom:" style="font-size: 11px; color: rgb(255, 226, 0);" />
                        <engine:VisualElement name="custom-list" style="margin-left: 12px;" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:Foldout>
    </engine:VisualElement>
</engine:UXML>

